#include <winver.h>
#include "resource.h"

IDI_SPLIT_ASIO ICON "../assets/split_asio.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SplitASIO - Split Input/Output Windows ASIO Driver"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "split_asio"
            VALUE "OriginalFilename", "split_asio.dll"
            VALUE "ProductName", "SplitASIO"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
